{
  "expo": {
    "name": "HabitRank",
    "slug": "habitrank",
    "scheme": "habitrank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.minephil.habitrank"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D14"
        }
      ],
      "./plugins/withoutPushEntitlement.js"
    ]
  }
}
